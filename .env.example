PORT=5001
MONGO_URI=mongodb://localhost:27017/musiramu
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5177
# --- EMAIL (Shop owner gets email on every change: customer, loan, payment, add_items, shop/profile update) ---
# Gmail (recommended for testing):
#  1) Enable 2FA on Google: https://myaccount.google.com/signinoptions/two-step-verification
#  2) Create App Password: https://myaccount.google.com/apppasswords -> Select "Mail" -> Generate (16 chars)
#  3) Use: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=your@gmail.com SMTP_PASS=abcd efgh ijkl mnop (no spaces)
# Alternatives: Brevo (smtp-relay.brevo.com:587), SendGrid (smtp.sendgrid.net:587), or Ethereal (auto-created if empty for dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_16_chars
EMAIL_FROM=noreply@musiramu.rw
SHOP_NAME=MusiRamu General Shop
# Optional Ethereal test (dev preview URLs): auto-created if SMTP_USER empty
# ETHEREAL_USER=
# ETHEREAL_PASS=
# --- SMS - eSMS Africa (Rwanda MTN/Airtel) - same events via SMS to shop owner ---
# Get key at https://auth.esmsafrica.io/register?service=sms - Sender ID at https://sms.esmsafrica.io
# Docs: https://docs.esmsafrica.io/docs/api-reference/messages
# Sender ID: 3-11 alphanumeric, must be approved per RURA (Rwanda)
ESMS_API_KEY=your_esms_api_key
ESMS_SENDER_ID=MusiRamu
ESMS_API_URL=https://sms.esmsafrica.io/api/messages/send
# --- SMS - SMSConnect Rwanda (https://smsconnect.tech) - preferred for Rwanda, direct MTN/Airtel ---
# Docs: https://smsconnect.tech/docs - Get key at https://smsconnect.tech/register
# Endpoint: POST https://api.smsconnect.rw/v1/send  Body: {to:"+250788...", from:"Sender", message:"text"}
# If SMSCONNECT_API_KEY is set, it is used first (before ESMS). Leave both empty for simulated (console only).
SMSCONNECT_API_KEY=your_smsconnect_api_key
SMSCONNECT_SENDER_ID=MusiRamu
SMSCONNECT_API_URL=https://api.smsconnect.rw/v1/send
